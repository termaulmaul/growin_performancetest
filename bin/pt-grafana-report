    position: relative;
  }}
  
  .header {{ display: flex; align-items: center; gap: var(--space-2); }}
  .header svg {{ width: var(--space-4); height: var(--space-4); color: var(--accent); filter: drop-shadow(0 0 10px var(--accent-glow)); }}
  h1 {{ font-family: var(--font-heading); color: var(--text-primary); font-size: calc(1rem * var(--phi) * var(--phi)); font-weight: 700; letter-spacing: -0.03em; margin: 0; text-transform: uppercase; }}
  
  h2 {{ font-family: var(--font-heading); color: var(--text-primary); margin: var(--space-5) 0 var(--space-3); font-size: calc(1rem * var(--phi)); font-weight: 600; display: flex; align-items: center; gap: var(--space-1); letter-spacing: -0.02em; }}
  
  .meta {{ 
    color: var(--text-muted); font-size: 0.85rem; 
