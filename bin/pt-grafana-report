#!/usr/bin/env python3
"""
pt-grafana-report — Generate a standalone HTML utilization report from Grafana metrics.

Usage:
    python3 bin/pt-grafana-report --start <epoch> --end <epoch> --output <path.html> [--backend-url http://localhost:5000]

Calls get_grafana_data Flask backend API (/api/metrics) and renders an HTML report.
Falls back gracefully if backend is unreachable.
"""

import argparse
import json
import sys
import os
import re
from datetime import datetime, timezone
from urllib.request import Request, urlopen
from urllib.error import URLError

DEFAULT_BACKEND = "http://localhost:5000"


def fetch_metrics(backend_url, from_iso, to_iso):
    """Call /api/metrics and /api/node-metrics on get_grafana_data backend."""
    import json
    from urllib.request import Request, urlopen
    from urllib.error import URLError
    
    payload = json.dumps({
        "from_date": from_iso,
        "to_date": to_iso,
        "group_pods": True
    }).encode("utf-8")
    
    headers = {"Content-Type": "application/json"}
    result = {"data": [], "node_data": []}
    
    # Fetch Pod metrics
    req_pods = Request(f"{backend_url}/api/metrics", data=payload, headers=headers)
    req_pods.method = "POST"
    try:
        with urlopen(req_pods, timeout=30) as resp:
            pod_data = json.loads(resp.read().decode("utf-8"))
            result["data"] = pod_data.get("data", [])
    except URLError as e:
        print(f"[pt-grafana-report] Backend unreachable for pod metrics: {e}", file=sys.stderr)
    except Exception as e:
        print(f"[pt-grafana-report] Error fetching pod metrics: {e}", file=sys.stderr)

    # Fetch Node metrics
    req_nodes = Request(f"{backend_url}/api/node-metrics", data=payload, headers=headers)
    req_nodes.method = "POST"
    try:
        with urlopen(req_nodes, timeout=30) as resp:
            node_data = json.loads(resp.read().decode("utf-8"))
            result["node_data"] = node_data.get("data", [])
    except URLError as e:
        print(f"[pt-grafana-report] Backend unreachable for node metrics: {e}", file=sys.stderr)
    except Exception as e:
        print(f"[pt-grafana-report] Error fetching node metrics: {e}", file=sys.stderr)
        
    if not result["data"] and not result["node_data"]:
        return None
        
    return result


def render_html(data, from_ts, to_ts, summary_file=None):
    """Build standalone HTML report from API response."""
    from datetime import datetime, timezone
    import json
    import os
    import re
    from_dt = datetime.fromtimestamp(from_ts, tz=timezone.utc).strftime("%d/%m/%Y, %H.%M")
    to_dt = datetime.fromtimestamp(to_ts, tz=timezone.utc).strftime("%d/%m/%Y, %H.%M")

    metrics = data.get("data", [])
    node_metrics = data.get("node_data", [])

    rows = ""
    for m in metrics:
        pod = m.get("pod", m.get("deployment", "unknown"))
        node = m.get("node", "")
        if not node and "tremappl" in pod: # basic fallback
            node = pod
            
        pod_count = m.get("pod_count", 1)
        
        # We need CPU and Memory %
        avg_cpu = m.get('avg_cpu_percent')
        min_cpu = m.get('min_cpu_percent')
        max_cpu = m.get('max_cpu_percent')
        avg_mem = m.get('avg_memory_percent')
        
        if avg_cpu is None:
            # Fallback to absolute if % is missing (though the design expects %)
            avg_cpu = m.get('avg_cpu_millicores', 0) / 10.0 # Just dummy calc or use raw
            min_cpu = m.get('min_cpu_millicores', 0) / 10.0
            max_cpu = m.get('max_cpu_millicores', 0) / 10.0
            avg_mem = m.get('avg_memory_mb', 0) / 10.0

        rows += f"""
        <tr>
            <td style="color:var(--text-primary); font-weight: 700;">{node}</td>
            <td style="font-weight: 700;">{pod}</td>
            <td style="color:var(--text-primary); font-weight: 600;">{pod_count}</td>
            <td class="num-val">{avg_cpu:.2f}</td>
            <td class="num-val">{min_cpu:.2f}</td>
            <td class="num-val">{max_cpu:.2f}</td>
            <td class="num-val">{avg_mem:.1f}</td>
        </tr>"""

    if not rows:
        rows = '<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:2rem;">No data returned from Grafana</td></tr>'

    node_rows = ""
    for n in node_metrics:
        # Use instance (IP:Port) and hostname from the backend
        ip = n.get('instance', 'Unknown IP').split(':')[0]
        node_name = n.get('hostname', n.get('node', 'unknown'))
        node_rows += f"""
        <tr>
            <td style="font-weight: 700;">{ip}</td>
            <td style="font-weight: 700;">{node_name}</td>
            <td class="num-val">{n.get('avg_cpu', 0):.2f}</td>
            <td class="num-val">{n.get('max_cpu', 0):.2f}</td>
            <td class="num-val">{n.get('avg_memory', 0):.2f}</td>
        </tr>"""

    # If backend didn't return node metrics, we can extract unique nodes from pod metrics as a fallback
    if not node_rows and metrics:
        unique_nodes = set(m.get("node", "Unknown") for m in metrics if m.get("node"))
        for n in sorted(unique_nodes):
            if n and n != "Unknown":
                node_rows += f"""
        <tr>
            <td style="font-weight: 700;">Unknown IP</td>
            <td style="font-weight: 700;">{n}</td>
            <td class="num-val">-</td>
            <td class="num-val">-</td>
            <td class="num-val">-</td>
        </tr>"""

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grafana Metrics Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {{
    --bg-color: #f1f5f9;
    --card-bg: #ffffff;
    --border: #e2e8f0;
    --text-primary: #334155;
    --text-muted: #64748b;
    --accent: #2563eb;
    --num-color: #3b82f6;
  }}
  
  * {{ box-sizing: border-box; margin: 0; padding: 0; }}
  
  body {{ 
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; 
    background-color: var(--bg-color); 
    color: var(--text-primary); 
    padding: 2rem; 
    line-height: 1.5; 
  }}
  
  .container {{ 
    max-width: 1000px; 
    margin: 0 auto; 
    background: var(--card-bg); 
    padding: 3rem; 
    border-radius: 12px; 
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); 
  }}
  
  h1 {{ 
    color: #1e293b; 
    font-size: 2.2rem; 
    font-weight: 700; 
    text-align: center; 
    margin-bottom: 2.5rem; 
  }}
  
  .controls-grid {{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }}
  
  .form-group {{ display: flex; flex-direction: column; gap: 0.5rem; }}
  .form-group label {{ font-weight: 700; color: var(--text-muted); font-size: 1.1rem; }}
  
  input[type="text"] {{
    background: #ffffff; border: 2px solid var(--border); color: var(--text-primary);
    padding: 0.8rem 1rem; border-radius: 6px; font-family: 'Inter', sans-serif; font-size: 1.1rem;
    pointer-events: none;
  }}
  
  select[multiple] {{ 
    border: 2px solid var(--border); border-radius: 6px; padding: 0.5rem;
    min-height: 140px; font-family: 'Inter', sans-serif; font-size: 1rem; color: var(--text-primary);
  }}
  select[multiple] option {{ padding: 0.4rem 0.5rem; }}
  
  .checkbox-group {{ display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; }}
  .checkbox-group input {{ width: 1.2rem; height: 1.2rem; cursor: pointer; accent-color: var(--accent); }}
  .checkbox-group label {{ font-weight: 700; cursor: pointer; color: var(--text-primary); font-size: 1.1rem; }}
  
