#!/usr/bin/env python3
"""
pt-grafana-report — Generate a standalone HTML utilization report from Grafana metrics.

Usage:
    python3 bin/pt-grafana-report --start <epoch> --end <epoch> --output <path.html> [--backend-url http://localhost:5000]

Calls get_grafana_data Flask backend API (/api/metrics) and renders an HTML report.
Falls back gracefully if backend is unreachable.
"""

import argparse
import json
import sys
import os
from datetime import datetime, timezone
from urllib.request import Request, urlopen
from urllib.error import URLError

DEFAULT_BACKEND = "http://localhost:5000"


def fetch_metrics(backend_url, from_iso, to_iso):
    """Call /api/metrics on get_grafana_data backend."""
    url = f"{backend_url}/api/metrics"
    payload = json.dumps({
        "from_date": from_iso,
        "to_date": to_iso,
        "group_pods": True
    }).encode("utf-8")
    req = Request(url, data=payload, headers={"Content-Type": "application/json"})
    req.method = "POST"
    try:
        with urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except URLError as e:
        print(f"[pt-grafana-report] Backend unreachable ({backend_url}): {e}", file=sys.stderr)
        return None
    except Exception as e:
        print(f"[pt-grafana-report] Error: {e}", file=sys.stderr)
        return None


def render_html(data, from_ts, to_ts):
    """Build standalone HTML report from API response."""
    from_dt = datetime.fromtimestamp(from_ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    to_dt = datetime.fromtimestamp(to_ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    generated = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    metrics = data.get("data", [])
    node_metrics = data.get("node_data", [])

    rows = ""
    for i, m in enumerate(metrics, 1):
        pod = m.get("pod", m.get("deployment", "unknown"))
        rows += f"""
        <tr>
            <td>{i}</td>
            <td>{pod}</td>
            <td>{m.get('avg_cpu', 0):.2f}</td>
            <td>{m.get('min_cpu', 0):.2f}</td>
            <td>{m.get('max_cpu', 0):.2f}</td>
            <td>{m.get('avg_memory', 0):.1f}</td>
            <td>{m.get('min_memory', 0):.1f}</td>
            <td>{m.get('max_memory', 0):.1f}</td>
        </tr>"""

    if not rows:
        rows = '<tr><td colspan="8" style="text-align:center;color:#888;">No data returned from Grafana</td></tr>'

    node_rows = ""
    for n in node_metrics:
        node_rows += f"""
        <tr>
            <td>{n.get('node', 'unknown')}</td>
            <td>{n.get('avg_cpu', 0):.2f}%</td>
            <td>{n.get('avg_memory', 0):.1f} MB</td>
        </tr>"""

    node_section = ""
    if node_rows:
        node_section = f"""
    <h2>🖥️ Node Utilization</h2>
    <table>
        <thead><tr><th>Node</th><th>Avg CPU %</th><th>Avg Memory</th></tr></thead>
        <tbody>{node_rows}</tbody>
    </table>"""

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grafana Utilization Report</title>
<style>
  :root {{ --bg: #0d1117; --card: #161b22; --border: #30363d; --text: #c9d1d9; --accent: #58a6ff; --green: #3fb950; --red: #f85149; }}
  * {{ margin:0; padding:0; box-sizing:border-box; }}
  body {{ font-family: 'Segoe UI', -apple-system, sans-serif; background: var(--bg); color: var(--text); padding: 2rem; }}
  h1 {{ color: var(--accent); margin-bottom: 0.5rem; font-size: 1.5rem; }}
  h2 {{ color: var(--accent); margin: 1.5rem 0 0.5rem; font-size: 1.1rem; }}
  .meta {{ color: #8b949e; font-size: 0.85rem; margin-bottom: 1.5rem; }}
  .meta span {{ margin-right: 1.5rem; }}
  table {{ width: 100%; border-collapse: collapse; background: var(--card); border-radius: 6px; overflow: hidden; margin-bottom: 1rem; }}
  th {{ background: #21262d; color: var(--accent); text-align: left; padding: 8px 12px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }}
  td {{ padding: 6px 12px; border-top: 1px solid var(--border); font-size: 0.85rem; }}
  tr:hover {{ background: #1c2128; }}
  .footer {{ margin-top: 2rem; color: #484f58; font-size: 0.75rem; }}
</style>
</head>
<body>
<h1>📈 Grafana Utilization Report</h1>
<div class="meta">
    <span>⏱️ {from_dt} → {to_dt}</span>
    <span>📅 Generated: {generated}</span>
</div>

<h2>🐳 Container Metrics (growin namespace)</h2>
<table>
    <thead>
        <tr>
            <th>#</th><th>Pod / Deployment</th>
            <th>Avg CPU (m)</th><th>Min CPU (m)</th><th>Max CPU (m)</th>
            <th>Avg Mem (MB)</th><th>Min Mem (MB)</th><th>Max Mem (MB)</th>
        </tr>
    </thead>
    <tbody>{rows}</tbody>
</table>

{node_section}

<div class="footer">
    growin_performancetest — Grafana Utilization Report — auto-generated by pt-grafana-report
</div>
</body>
</html>"""
    return html


def main():
    parser = argparse.ArgumentParser(description="Generate Grafana utilization HTML report")
    parser.add_argument("--start", required=True, help="Start epoch timestamp")
    parser.add_argument("--end", required=True, help="End epoch timestamp")
    parser.add_argument("--output", required=True, help="Output HTML file path")
    parser.add_argument("--backend-url", default=DEFAULT_BACKEND, help="Grafana data backend URL")
    args = parser.parse_args()

    from_ts = int(args.start)
    to_ts = int(args.end)
    from_iso = datetime.fromtimestamp(from_ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    to_iso = datetime.fromtimestamp(to_ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")

    data = fetch_metrics(args.backend_url, from_iso, to_iso)

    if data is None:
        # Generate empty report with note
        data = {"data": [], "node_data": []}
        print("[pt-grafana-report] Backend unavailable, generating empty report.", file=sys.stderr)

    html = render_html(data, from_ts, to_ts)

    os.makedirs(os.path.dirname(args.output) or ".", exist_ok=True)
    with open(args.output, "w", encoding="utf-8") as f:
        f.write(html)
    print(f"[pt-grafana-report] Report saved: {args.output}")
    # Print path to stdout for caller to capture
    print(args.output)


if __name__ == "__main__":
    main()
