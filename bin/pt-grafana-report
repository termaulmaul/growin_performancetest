#!/usr/bin/env python3
"""
pt-grafana-report — Generate a standalone HTML utilization report from Grafana metrics.

Usage:
    python3 bin/pt-grafana-report --start <epoch> --end <epoch> --output <path.html> [--backend-url http://localhost:5000]

Calls get_grafana_data Flask backend API (/api/metrics) and renders an HTML report.
Falls back gracefully if backend is unreachable.
"""

import argparse
import json
import sys
import os
import re
from datetime import datetime, timezone
from urllib.request import Request, urlopen
from urllib.error import URLError

DEFAULT_BACKEND = "http://localhost:5000"


def fetch_metrics(backend_url, from_iso, to_iso):
    """Call /api/metrics on get_grafana_data backend."""
    url = f"{backend_url}/api/metrics"
    payload = json.dumps({
        "from_date": from_iso,
        "to_date": to_iso,
        "group_pods": True
    }).encode("utf-8")
    req = Request(url, data=payload, headers={"Content-Type": "application/json"})
    req.method = "POST"
    try:
        with urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except URLError as e:
        print(f"[pt-grafana-report] Backend unreachable ({backend_url}): {e}", file=sys.stderr)
        return None
    except Exception as e:
        print(f"[pt-grafana-report] Error: {e}", file=sys.stderr)
        return None


def render_html(data, from_ts, to_ts, summary_file=None):
    """Build standalone HTML report from API response."""
    from_dt = datetime.fromtimestamp(from_ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    to_dt = datetime.fromtimestamp(to_ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    generated = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    # Extract custom metric names from K6 summary to override Pod names
    api_names = ""
    if summary_file and os.path.isfile(summary_file):
        try:
            with open(summary_file, 'r', encoding='utf-8') as f:
                sum_data = json.load(f)
                custom_metrics = sum_data.get("custom_metrics", {})
                unique_names = set()
                for key in custom_metrics.keys():
                    # Strip prefixes like duration_, error_rate_, and numeric patterns (e.g. 001_01_01_)
                    name = re.sub(r'^(duration|error_rate|error_count|sample|rps|waiting)_(?:\d{3}_(?:\d{2}_)+)?', '', key)
                    if name:
                        unique_names.add(name)
                if unique_names:
                    api_names = " / ".join(sorted(unique_names))
        except Exception as e:
            print(f"[pt-grafana-report] Warning: Failed to parse summary file: {e}", file=sys.stderr)

    metrics = data.get("data", [])
    node_metrics = data.get("node_data", [])

    rows = ""
    for i, m in enumerate(metrics, 1):
        pod = m.get("pod", m.get("deployment", "unknown"))
        display_name = f"{api_names}<br><small style='color:#8b949e'>({pod})</small>" if api_names else pod
        rows += f"""
        <tr>
            <td>{i}</td>
            <td>{display_name}</td>
            <td>{m.get('avg_cpu_millicores', 0):.2f}</td>
            <td>{m.get('min_cpu_millicores', 0):.2f}</td>
            <td>{m.get('max_cpu_millicores', 0):.2f}</td>
            <td>{m.get('avg_memory_mb', 0):.1f}</td>
            <td>{m.get('min_memory_mb', 0):.1f}</td>
            <td>{m.get('max_memory_mb', 0):.1f}</td>
        </tr>"""

    if not rows:
        rows = '<tr><td colspan="8" style="text-align:center;color:#888;">No data returned from Grafana</td></tr>'

    node_rows = ""
    for n in node_metrics:
        node_rows += f"""
        <tr>
            <td>{n.get('node', 'unknown')}</td>
            <td>{n.get('avg_cpu', 0):.2f}%</td>
            <td>{n.get('avg_memory', 0):.1f} MB</td>
        </tr>"""

    node_section = ""
    if node_rows:
        node_section = f"""
    <h2>🖥️ Node Utilization</h2>
    <table>
        <thead><tr><th>Node</th><th>Avg CPU %</th><th>Avg Memory</th></tr></thead>
        <tbody>{node_rows}</tbody>
    </table>"""

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grafana Utilization Report</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {{ --bg: #0f172a; --card: #1e293b; --border: #334155; --text: #e2e8f0; --muted: #94a3b8; --accent: #3b82f6; --k8s: #326ce5; --row-hover: #2dd4bf10; }}
  * {{ margin:0; padding:0; box-sizing:border-box; }}
  body {{ font-family: 'Inter', -apple-system, sans-serif; background: var(--bg); color: var(--text); padding: 2.5rem; line-height: 1.5; }}
  .container {{ max-width: 1200px; margin: 0 auto; }}
  .header {{ display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }}
  .header svg {{ width: 40px; height: 40px; color: var(--k8s); }}
  h1 {{ color: #f8fafc; font-size: 1.8rem; font-weight: 700; letter-spacing: -0.02em; }}
  h2 {{ color: #f8fafc; margin: 2rem 0 1rem; font-size: 1.2rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }}
  .meta {{ color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; display: flex; gap: 1.5rem; background: var(--card); padding: 1rem; border-radius: 8px; border: 1px solid var(--border); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }}
  .meta span {{ display: flex; align-items: center; gap: 0.4rem; }}
  table {{ width: 100%; border-collapse: separate; border-spacing: 0; background: var(--card); border-radius: 10px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); border: 1px solid var(--border); }}
  th {{ background: #0f172a; color: var(--muted); text-align: left; padding: 12px 16px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; border-bottom: 1px solid var(--border); }}
  td {{ padding: 12px 16px; border-bottom: 1px solid var(--border); font-size: 0.9rem; transition: background-color 0.2s; }}
  tr:last-child td {{ border-bottom: none; }}
  tr:hover td {{ background: var(--row-hover); }}
  .unit {{ color: var(--muted); font-size: 0.8em; margin-left: 2px; }}
  .footer {{ margin-top: 3rem; color: var(--muted); font-size: 0.8rem; text-align: center; padding-top: 1.5rem; border-top: 1px solid var(--border); }}
  @keyframes fadeIn {{ from {{ opacity: 0; transform: translateY(10px); }} to {{ opacity: 1; transform: translateY(0); }} }}
  .animate {{ animation: fadeIn 0.4s ease-out forwards; }}
</style>
</head>
<body>
<div class="container animate">
    <div class="header">
        <svg viewBox="0 0 120 119" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
            <path d="M59.9 0l59.6 34.3v68.5l-59.6 34.4L.4 102.8V34.3L59.9 0zm0 18.2L16.2 43.4v50.4L59.9 119l43.7-25.2V43.4L59.9 18.2zm28.7 34.4c.5-2.2 2-3.8 4-4.5 2-.8 4.3-.4 6 .9.6.5 1 1 1.4 1.7L96 61l-5.6-3.8c-1-.7-2.3-.9-3.5-.5-.8.3-1.4 1-1.7 1.8L79.6 77.2l-3.3-8.8 12.3-15.8zm-57.4 0l12.3 15.8-3.3 8.8-5.6-18.7c-.3-.8-.9-1.5-1.7-1.8-1.2-.4-2.5-.2-3.5.5L14.6 61l4.1-10.3c.4-.7.9-1.3 1.4-1.7 1.7-1.3 4-1.7 6-.9 2 .7 3.5 2.3 4 4.5v-.1zM60 21.6c1 0 1.9.4 2.5 1.1.7.6 1.1 1.5 1.1 2.5v16.1l9.6-1.7 5.6-8.5c.8-.9 2-1.4 3.2-1.3 1 .1 1.8.6 2.5 1.3.8.8 1.1 1.9 1 3l-.6 10-15.2-1.4-5.2 6.7 8.3 8.3 12.9-7.5h.1c1.8-1 4.1-.7 5.7.5 1.5 1.2 2.2 3.1 1.8 5l-4.1 14.2-11.8 2.1-4.7 9.8 4.7 9.8 11.8 2.1 4.1 14.2c.4 1.9-.3 3.8-1.8 5-1.6 1.2-3.9 1.5-5.7.5L81.2 92l-8.3 8.3 5.2 6.7 15.2-1.4.6 10c.1 1.1-.2 2.2-1 3-.7.7-1.5 1.2-2.5 1.3-1.2.1-2.4-.4-3.2-1.3l-5.6-8.5-9.6-1.7v16.1c0 1-.4 1.9-1.1 2.5-.6.7-1.5 1.1-2.5 1.1-1 0-1.9-.4-2.5-1.1-.7-.6-1.1-1.5-1.1-2.5V108l-9.6 1.7-5.6 8.5c-.8.9-2 1.4-3.2 1.3-1-.1-1.8-.6-2.5-1.3-.8-.8-1.1-1.9-1-3l.6-10 15.2 1.4 5.2-6.7-8.3-8.3-12.9 7.5c-1.8 1-4.1.7-5.7-.5-1.5-1.2-2.2-3.1-1.8-5l4.1-14.2 11.8-2.1 4.7-9.8-4.7-9.8-11.8-2.1-4.1-14.2c-.4-1.9.3-3.8 1.8-5 1.6-1.2 3.9-1.5 5.7-.5l12.9 7.5 8.3-8.3-5.2-6.7L33.7 34l-.6-10c-.1-1.1.2-2.2 1-3 .7-.7 1.5-1.2 2.5-1.3 1.2-.1 2.4.4 3.2 1.3l5.6 8.5 9.6 1.7V25.2c0-1 .4-1.9 1.1-2.5.6-.7 1.5-1.1 2.5-1.1z"/>
        </svg>
        <h1>Grafana Utilization Report</h1>
    </div>
    <div class="meta">
        <span>⏱️ {from_dt} → {to_dt}</span>
        <span>📅 Generated: {generated}</span>
    </div>

    <h2>☸️ Kubernetes Pod Metrics (growin namespace)</h2>
    <table>
        <thead>
            <tr>
                <th>#</th><th>API Scenario / Deployment</th>
            <th>Avg CPU (m)</th><th>Min CPU (m)</th><th>Max CPU (m)</th>
            <th>Avg Mem (MB)</th><th>Min Mem (MB)</th><th>Max Mem (MB)</th>
        </tr>
    </thead>
    <tbody>{rows}</tbody>
</table>

{node_section}

<div class="footer">
    growin_performancetest — Grafana Utilization Report — auto-generated by pt-grafana-report
</div>
</body>
</html>"""
    return html


import subprocess
import time
import socket

def is_port_in_use(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(('127.0.0.1', port)) == 0

def start_backend_if_needed():
    """Start the Grafana backend if it's not already running, using a free port."""
    ports_to_try = [5000, 5001, 5002]
    
    # 1. Check if backend is already running on a previously saved port
    port_file = "/tmp/grafana_backend_port"
    if os.path.exists(port_file):
        try:
            with open(port_file, 'r') as f:
                saved_port = int(f.read().strip())
            
            # Simple health check
            req = Request(f"http://localhost:{saved_port}/health")
            with urlopen(req, timeout=2) as resp:
                if resp.status == 200:
                    return f"http://localhost:{saved_port}"
        except Exception:
            pass # Backend not running on saved port, continue to start it

    # 2. Find a free port
    chosen_port = None
    for port in ports_to_try:
        if not is_port_in_use(port):
            chosen_port = port
            break
            
    if not chosen_port:
        print("[pt-grafana-report] Could not find a free port for backend.", file=sys.stderr)
        return DEFAULT_BACKEND

    # 3. Start the backend via start_backend.sh to ensure venv is handled
    base_dir = os.path.dirname(os.path.dirname(__file__))
    grafana_dir = os.path.join(base_dir, "get_grafana_data")
    start_script = os.path.join(grafana_dir, "start_backend.sh")
    
    if not os.path.exists(start_script):
        return DEFAULT_BACKEND
        
    print(f"[pt-grafana-report] Starting backend on port {chosen_port}...", file=sys.stderr)
    env = os.environ.copy()
    env["PORT"] = str(chosen_port)
    
    # Run detached
    subprocess.Popen(
        ["bash", start_script],
        env=env,
        cwd=grafana_dir,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )
    
    # 4. Wait for it to become responsive
    backend_url = f"http://localhost:{chosen_port}"
    for _ in range(10):
        time.sleep(0.5)
        try:
            req = Request(f"{backend_url}/health")
            with urlopen(req, timeout=1) as resp:
                if resp.status == 200:
                    with open(port_file, 'w') as f:
                        f.write(str(chosen_port))
                    return backend_url
        except Exception:
            continue
            
    print("[pt-grafana-report] Backend failed to start or respond in time.", file=sys.stderr)
    return backend_url


def main():
    parser = argparse.ArgumentParser(description="Generate Grafana utilization HTML report")
    parser.add_argument("--start", required=True, help="Start epoch timestamp")
    parser.add_argument("--end", required=True, help="End epoch timestamp")
    parser.add_argument("--output", required=True, help="Output HTML file path")
    parser.add_argument("--backend-url", default=None, help="Grafana data backend URL")
    parser.add_argument("--summary", default=None, help="Path to K6 summary JSON file")
    args = parser.parse_args()

    backend_url = args.backend_url
    if not backend_url:
        backend_url = start_backend_if_needed()

    from_ts = int(args.start)
    to_ts = int(args.end)
    from_iso = datetime.fromtimestamp(from_ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    to_iso = datetime.fromtimestamp(to_ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")

    data = fetch_metrics(backend_url, from_iso, to_iso)

    if data is None:
        # Generate empty report with note
        data = {"data": [], "node_data": []}
        print("[pt-grafana-report] Backend unavailable, generating empty report.", file=sys.stderr)

    html = render_html(data, from_ts, to_ts, args.summary)

    os.makedirs(os.path.dirname(args.output) or ".", exist_ok=True)
    with open(args.output, "w", encoding="utf-8") as f:
        f.write(html)
    print(f"[pt-grafana-report] Report saved: {args.output}")
    # Print path to stdout for caller to capture
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
    except Exception:
        ip = "127.0.0.1"
    finally:
        s.close()
    from urllib.parse import urlparse
    port = urlparse(backend_url).port or 5000
    public_url = f"http://{ip}:{port}/report/{os.path.basename(args.output)}"
    print(f"[pt-grafana-report] Public URL: {public_url}")
    print(public_url)


if __name__ == "__main__":
    main()
