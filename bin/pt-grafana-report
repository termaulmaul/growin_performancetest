<script>
    // Chart.js rendering using injected data
    const chartData = {chart_data_json};
    
    if (chartData && chartData.length > 0) {{
        const ctx = document.getElementById('metricsChart').getContext('2d');
        
        // Set Chart.js defaults to match dark glassmorphism theme
        Chart.defaults.color = '#8b949e';
        Chart.defaults.font.family = "'JetBrains Mono', monospace";
        
        const gradientCPU = ctx.createLinearGradient(0, 0, 0, 400);
        gradientCPU.addColorStop(0, 'rgba(34, 211, 238, 0.8)');
        gradientCPU.addColorStop(1, 'rgba(34, 211, 238, 0.1)');
        
        const gradientMem = ctx.createLinearGradient(0, 0, 0, 400);
        gradientMem.addColorStop(0, 'rgba(139, 92, 246, 0.8)');
        gradientMem.addColorStop(1, 'rgba(139, 92, 246, 0.1)');

        new Chart(ctx, {{
            type: 'bar',
            data: {{
                labels: chartData.map(d => d.pod.length > 20 ? d.pod.substring(0, 20) + '...' : d.pod),
                datasets: [
                    {{
                        label: 'Avg CPU (m)',
                        data: chartData.map(d => d.avg_cpu),
                        backgroundColor: gradientCPU,
                        borderColor: '#22d3ee',
                        borderWidth: 1,
                        borderRadius: 4,
                        yAxisID: 'y'
                    }},
                    {{
                        label: 'Avg Memory (MB)',
                        data: chartData.map(d => d.avg_mem),
                        backgroundColor: gradientMem,
                        borderColor: '#8b5cf6',
                        borderWidth: 1,
                        borderRadius: 4,
                        yAxisID: 'y1'
                    }}
                ]
            }},
            options: {{
                responsive: true,
                maintainAspectRatio: false,
