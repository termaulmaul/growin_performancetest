#!/usr/bin/env python3
"""
pt-grafana-report — Generate a standalone HTML utilization report from Grafana metrics.

Usage:
    python3 bin/pt-grafana-report --start <epoch> --end <epoch> --output <path.html> [--backend-url http://localhost:5000]

Calls get_grafana_data Flask backend API (/api/metrics) and renders an HTML report.
Falls back gracefully if backend is unreachable.
"""

import argparse
import json
import sys
import os
import re
from datetime import datetime, timezone
from urllib.request import Request, urlopen
from urllib.error import URLError

DEFAULT_BACKEND = "http://localhost:5000"


def fetch_metrics(backend_url, from_iso, to_iso):
    """Call /api/metrics on get_grafana_data backend."""
    url = f"{backend_url}/api/metrics"
    payload = json.dumps({
        "from_date": from_iso,
        "to_date": to_iso,
        "group_pods": True
    }).encode("utf-8")
    req = Request(url, data=payload, headers={"Content-Type": "application/json"})
    req.method = "POST"
    try:
        with urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except URLError as e:
        print(f"[pt-grafana-report] Backend unreachable ({backend_url}): {e}", file=sys.stderr)
        return None
    except Exception as e:
        print(f"[pt-grafana-report] Error: {e}", file=sys.stderr)
        return None


def render_html(data, from_ts, to_ts, summary_file=None):
    """Build standalone HTML report from API response."""
    from_dt = datetime.fromtimestamp(from_ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    to_dt = datetime.fromtimestamp(to_ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    generated = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    # Extract custom metric names from K6 summary to override Pod names
    api_names = ""
    prefixes = set()
    if summary_file and os.path.isfile(summary_file):
        try:
            with open(summary_file, 'r', encoding='utf-8') as f:
                sum_data = json.load(f)
                custom_metrics = sum_data.get("custom_metrics", {})
                unique_names = set()
                for key in custom_metrics.keys():
                    # Strip prefixes like duration_, error_rate_, and numeric patterns (e.g. 001_01_01_)
                    name = re.sub(r'^(duration|error_rate|error_count|sample|rps|waiting)_(?:\d{3}_(?:\d{2}_)+)?', '', key)
                    if name:
                        unique_names.add(name)
                        # Extract the first word before underscore to match with pod name
                        prefix = name.split('_')[0].lower()
                        if prefix:
                            prefixes.add(prefix)
                if unique_names:
                    api_names = " / ".join(sorted(unique_names))
        except Exception as e:
            print(f"[pt-grafana-report] Warning: Failed to parse summary file: {e}", file=sys.stderr)

    metrics = data.get("data", [])
    node_metrics = data.get("node_data", [])

    # Filter metrics to only include pods matching the K6 custom metric prefix
    filtered_metrics = []
    if prefixes:
        for m in metrics:
            pod = m.get("pod", m.get("deployment", "unknown")).lower()
            if any(p in pod for p in prefixes):
                filtered_metrics.append(m)
        # We strictly do not fallback. If a pod doesn't match the test scenario, it shouldn't be shown.
    else:
        filtered_metrics = metrics

    rows = ""
    for i, m in enumerate(filtered_metrics, 1):
        pod = m.get("pod", m.get("deployment", "unknown"))
        
        # Match the specific API name(s) that caused this pod to be included
        matched_apis = [name for name in unique_names if name.split('_')[0].lower() in pod.lower()]
        display_api = " / ".join(sorted(matched_apis))
        
        if display_api:
            display_name = f"<span class='api-name'>{display_api}</span><span class='pod-name'>{pod}</span>"
        else:
            display_name = f"<span class='api-name'>{pod}</span>"

        rows += f"""
        <tr>
            <td style="color:var(--text-muted)">{i}</td>
            <td>{display_name}</td>
            <td class="num-val">{m.get('avg_cpu_millicores', 0):.2f}<span class="unit">m</span></td>
            <td class="num-val">{m.get('min_cpu_millicores', 0):.2f}<span class="unit">m</span></td>
            <td class="num-val">{m.get('max_cpu_millicores', 0):.2f}<span class="unit">m</span></td>
            <td class="num-val">{m.get('avg_memory_mb', 0):.1f}<span class="unit">MB</span></td>
            <td class="num-val">{m.get('min_memory_mb', 0):.1f}<span class="unit">MB</span></td>
            <td class="num-val">{m.get('max_memory_mb', 0):.1f}<span class="unit">MB</span></td>
        </tr>"""

    if not rows:
        rows = '<tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:var(--space-4);">No data returned from Grafana</td></tr>'

    node_rows = ""
    for n in node_metrics:
        node_rows += f"""
        <tr>
            <td><span class='api-name'>{n.get('node', 'unknown')}</span></td>
            <td class="num-val">{n.get('avg_cpu', 0):.2f}<span class="unit">%</span></td>
            <td class="num-val">{n.get('avg_memory', 0):.1f}<span class="unit">MB</span></td>
        </tr>"""

    node_section = ""
    if node_rows:
        node_section = f"""
    <h2 class="animate-3">🖥️ Node Utilization</h2>
    <div class="table-wrapper animate-3">
        <table>
            <thead><tr><th>Node</th><th>Avg CPU</th><th>Avg Memory</th></tr></thead>
            <tbody>{node_rows}</tbody>
        </table>
    </div>"""

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
