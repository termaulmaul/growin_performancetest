# ── Growin PT Framework — Config Template ───────────────────────────────────
# Private repo — team use only.
# Auto-copied to configs/pt.env on first ./pt-menu.sh if pt.env absent.

ENV=INT
K6_USERS=100
DURATION=5m
RUNBY=Manual

# Onprem: jump qa@10.82.15.72 → qa@10.184.120.48
ONPREM_BASE_URL=https://int-api.onprem.growin.com

# Oncloud: gcloud compute ssh --zone asia-southeast2-c vm-pt-ksix-0 --tunnel-through-iap --project compute-pt
ONCLOUD_BASE_URL=https://int-api-oncloud.growin.com

# Sandbox Docker: pt-sandbox-ssh container on port 2222
SANDBOX_BASE_URL=http://localhost:18080

# SSH password — Onprem jumps + Sandbox container (qa@127.0.0.1:2222)
PT_SSH_PASS=M@nsek.1234

# k6 test accounts password (TESTMON series)
TEST_PASSWORD=M@nsek.123

# 2FA PIN
TEST_PIN=123456

# Webhooks
NOTIFY_TEAMS=true
TEAMS_WEBHOOK=https://defaultd3dc75f5a4ce4c659734a8430d86f5.ac.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/c93df6900cc84ab5920be1b006005f92/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=hx1ase6P85ZmQ28QbpwdUyxm0fmqgrvKMH9bhRrGUdg
TELEGRAM_WEBHOOK=
DISCORD_WEBHOOK=
BRRR_WEBHOOK=

THRESHOLD_AVG_MS=200
THRESHOLD_ERR_PCT=0.1
THRESHOLD_MIN_RPS=381

K6_INSECURE_SKIP_TLS_VERIFY=true
