# ── Growin PT Framework — Config Template ───────────────────────────────────
# Private repo — team use only. Do not share outside organization.
# Usage: cp configs/pt.env.example configs/pt.env

# ── Test Parameters ──────────────────────────────────────────────────────────
ENV=INT
K6_USERS=100
DURATION=5m
RUNBY=Manual

# ── Onprem Target ────────────────────────────────────────────────────────────
ONPREM_BASE_URL=https://int-api.onprem.growin.com

# ── Oncloud GCP Target ───────────────────────────────────────────────────────
ONCLOUD_BASE_URL=https://int-api-oncloud.growin.com

# ── SSH Access ───────────────────────────────────────────────────────────────
# Jump host: qa@10.82.15.72 (pass below) → qa@10.184.120.48 (same pass)
PT_SSH_PASS=M@nsek.1234

# ── Test Credentials ─────────────────────────────────────────────────────────
# k6 test accounts (TESTMON01@guysmail.com, TESTMON02@guysmail.com, ...)
TEST_PASSWORD=M@nsek.123
# 2FA PIN (Growin_2FA.js setup login flow)
TEST_PIN=123456

# ── Notification Webhooks ────────────────────────────────────────────────────
# Paste Power Automate webhook URL after rotating (old one was purged from history)
NOTIFY_TEAMS=false
TEAMS_WEBHOOK=
TELEGRAM_WEBHOOK=
DISCORD_WEBHOOK=
BRRR_WEBHOOK=

# ── Thresholds ───────────────────────────────────────────────────────────────
THRESHOLD_AVG_MS=200
THRESHOLD_ERR_PCT=0.1
THRESHOLD_MIN_RPS=381

# ── K6 Options ───────────────────────────────────────────────────────────────
K6_INSECURE_SKIP_TLS_VERIFY=true
