# ── Growin PT Framework — Config Template ───────────────────────────────────
# SAFE TO COMMIT — no real values here.
# Usage: cp configs/pt.env.example configs/pt.env  then fill in real values.
# configs/pt.env is gitignored.

ENV=INT
K6_USERS=100
DURATION=5m
RUNBY=Manual

ONPREM_BASE_URL=https://int-api.onprem.growin.com
ONCLOUD_BASE_URL=https://int-api-oncloud.growin.com

# SSH password for Onprem jump host (REQUIRED — no default fallback)
PT_SSH_PASS=

# Test account password used by getUserCredentials() in Helper/config.js
TEST_PASSWORD=

# 2FA PIN used by Growin_2FA.js setup() login flow
TEST_PIN=

# Webhook notifications (optional)
NOTIFY_TEAMS=false
TEAMS_WEBHOOK=
TELEGRAM_WEBHOOK=
DISCORD_WEBHOOK=
BRRR_WEBHOOK=

# Gate thresholds for webhook pass/fail reporting
THRESHOLD_AVG_MS=200
THRESHOLD_ERR_PCT=0.1
THRESHOLD_MIN_RPS=381

K6_INSECURE_SKIP_TLS_VERIFY=true
