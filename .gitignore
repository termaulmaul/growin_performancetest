# =============================================================================
# Growin Performance Test — .gitignore
# =============================================================================

# --- Node / JS ---
node_modules/
dist/
*.log
npm-debug.log*

# --- Java / JVM ---
*.class
*.jar
target/

# --- Python ---
*.py[cod]
__pycache__/
*.egg-info/
.venv/
venv/

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo

# --- OS junk ---
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# --- Test artifacts ---
TEST*.xml
results/
artifacts/results/
docker-local-pt/results/*.json
docker-local-pt/results/*.md
!docker-local-pt/results/.gitkeep
.audit_guard_report.md
.audit_guard_report.json
.check_syntax_report.json
.refresh_report.json

# --- Reports (heavy, keep template only) ---
Report/*
!Report/[Template_Report]/
!Report/[Template_Report]/***.apk

# --- Secrets / runtime data ---
.pt/
*.token
*.env.local
configs/*.local.env
pt-data/active_run.json
pt-data/users.json
security.db
**/security.db
.audit_guard_report.json

# --- Binaries (k6, large blobs) ---
k6
k6-linux-amd64
k6-linux-arm64
k6-darwin-*
*.app
*.exe
*.war

# --- Media (heavy) ---
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
*.apk
*.ipa

# --- Backups / patches / scratch ---
*.bak
*.bak2
*.orig
*.rej
*.patch
patch_*.js
patch_*.py
fix-*.sh
*~

# --- Obsidian / Cursor / Playwright junk ---
.obsidian/
.cursor/
.playwright-mcp/
.claude/
*.canvas

# --- Misc ---
*.tmp
*.cache
