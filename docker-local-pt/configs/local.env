# ── Local mock PT env (gitignored). Do not commit.
PT_RUNNER=docker-local-pt/scripts/k6-mock-runner.js
SUITE=Growin_PT_Dev[ToDo]
SCENARIO=BP001
PLATFORM=Web
VARIANT=original
ENV=INT
RUNBY=LocalDocker
K6_USERS=1
USER_COUNT=1
DURATION=30s
NUMSTART=1
DEBUG=false
BP_CONFIG=
BP_CONFIG_FILE=/results/BP001.json
BASE_URL=http://mock-api:8080
STRICT_PLATFORM_IMPLEMENTATION=false
ALLOW_ANDROID_WEB_FALLBACK=true
THINK_TIME_JITTER=true
K6_INSECURE_SKIP_TLS_VERIFY=true
USE_GRAFANA_OUTPUT=false
MOCK_LATENCY_MS=80
MOCK_ERROR_RATE=0

GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
NOTIFY_TEAMS=true
