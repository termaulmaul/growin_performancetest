# ─────────────────────────────────────────────────────────────────────────────
# Local PT — DEMO env (gitignored). Do not commit secrets.
#
# Use this file for k6-runner container env. For pt-menu.sh real-target config,
# see /configs/pt.env at repo root.
# ─────────────────────────────────────────────────────────────────────────────

# ── Target selection (used by sandbox runner) ───────────────────────────────
PT_TARGET=Sandbox
ENV=SANDBOX
BASE_URL=http://mock-api:8080

# Alternative target BASE_URL examples (override per-run):
#   PT_TARGET=Onprem  ENV=INT     BASE_URL=https://internal-api-pt.growin.id
#   PT_TARGET=Oncloud ENV=ONCLOUD BASE_URL=https://int-api-oncloud.growin.com
#   PT_TARGET=Sandbox ENV=SANDBOX BASE_URL=http://mock-api:8080

# ── Test parameters ─────────────────────────────────────────────────────────
SUITE=Growin_Calendar
SCENARIO=BP001
PLATFORM=Web
VARIANT=original
RUNBY=LocalDocker
K6_USERS=1
USER_COUNT=1
DURATION=30s
NUMSTART=1
DEBUG=false

# ── Mock API behaviour ──────────────────────────────────────────────────────
MOCK_LATENCY_MS=80
MOCK_ERROR_RATE=0
MOCK_STATUS=
STRICT_PLATFORM_IMPLEMENTATION=false
ALLOW_ANDROID_WEB_FALLBACK=true
THINK_TIME_JITTER=true

# ── k6 ──────────────────────────────────────────────────────────────────────
K6_INSECURE_SKIP_TLS_VERIFY=true
USE_GRAFANA_OUTPUT=false

# ── Observability (only used with --profile observability) ──────────────────
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Notifications (gitignored — fill in real values, do not commit) ─────────
NOTIFY_TEAMS=false
TEAMS_WEBHOOK=
TELEGRAM_WEBHOOK=
DISCORD_WEBHOOK=
BRRR_WEBHOOK=
